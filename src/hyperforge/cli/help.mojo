"""Human-readable CLI help. Rendered to stdout only."""

from hyperforge.core.version import VERSION, MILESTONE


def print_help() raises:
    print(
        "hyperforge " + VERSION + " (" + MILESTONE + ")\n"
        + "Native Mojo CLI for reproducible research and discovery.\n"
        + "\n"
        + "USAGE\n"
        + "  hyperforge <command> [options]\n"
        + "\n"
        + "IMPLEMENTED COMMANDS\n"
        + "  --help, -h              Show this help and exit\n"
        + "  --version, -V           Print version and exit\n"
        + "  doctor [--json]         Report toolchain and capability status\n"
        + "  init <path>             Initialize a versioned local workspace\n"
        + "  experiment create <name> [seed]\n"
        + "                          Create a versioned experiment record\n"
        + "  experiment list [--json]\n"
        + "                          List local experiment records\n"
        + "  experiment show <id> [--json]\n"
        + "                          Inspect one experiment and its events\n"
        + "  experiment replay <id>  Verify inputs before replay\n"
        + "  automl inspect <csv> <target>\n"
        + "                          Validate a CSV dataset and show its schema\n"
        + "  automl run <csv> <target> [budget] [seed]\n"
        + "                          Run bounded regression AutoML on CPU\n"
        + "  automl show <id>        List trials for an experiment\n"
        + "  automl replay <id>      Recompute and verify a recorded result\n"
        + "  automl compare <a> <b>  Compare held-out RMSE of two experiments\n"
        + "  report <id>             Render a terminal report\n"
        + "  optimize run <csv> <target> [budget] [seed]\n"
        + "                          Adaptive search vs matched random baseline\n"
        + "  sinn list-problems      List supported scientific PDE problems\n"
        + "  sinn solve <problem> [seed] [iterations]\n"
        + "                          Solve a PDE with a physics-informed Mojo network\n"
        + "  sinn show <id>          Inspect a persisted SINN result\n"
        + "  sci-transformers train [seed] [epochs]\n"
        + "                          Train the scientific sequence transformer\n"
        + "  sci-transformers show <id>\n"
        + "                          Inspect a persisted transformer result\n"
        + "  sci-transformers predict <id> [sample]\n"
        + "                          Predict a held-out frame from a checkpoint\n"
        + "\n"
        + "PLANNED COMMANDS (not registered; no behavior yet)\n"
        + "  experiment compare, benchmark run, verify, discover,\n"
        + "  classification, multi-fidelity search\n"
        + "\n"
        + "EXIT CODES\n"
        + "  0 success    1 failure    2 usage error    3 unavailable\n"
        + "  70 internal error    130 interrupted\n"
        + "\n"
        + "EXAMPLES\n"
        + "  hyperforge doctor\n"
        + "  hyperforge init ./workspace\n"
    )


def print_version() raises:
    print("hyperforge " + VERSION + " (" + MILESTONE + ")")
