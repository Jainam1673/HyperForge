"""Human-readable CLI help. Rendered to stdout only."""

from hyperforge.core.version import VERSION, MILESTONE


def print_help() raises:
    print(
        "hyperforge " + VERSION + " (" + MILESTONE + ")\n"
        + "Native Mojo CLI for reproducible research and discovery.\n"
        + "\n"
        + "USAGE\n"
        + "  hyperforge <command> [options]\n"
        + "\n"
        + "IMPLEMENTED COMMANDS\n"
        + "  --help, -h              Show this help and exit\n"
        + "  --version, -V           Print version and exit\n"
        + "  doctor [--json] [--gpu] Report capability status; --gpu runs a kernel\n"
        + "  hardware probe|catalogue Probe accelerator or list GPU kernels\n"
        + "  benchmark kernel [name] [size] [reps]\n"
        + "                          Benchmark a catalogued GPU kernel\n"
        + "  discover run [budget] [seed]\n"
        + "                          Reciprocal AI/compute search comparison\n"
        + "  autodl run [budget] [seed]\n"
        + "                          Search real MLP architectures on CPU\n"
        + "  autodl show <id>        Inspect an AutoDL result\n"
        + "  autodl replay <id>      Verify a restored checkpoint\n"
        + "  autorl list-envs        List deterministic RL environments\n"
        + "  autorl run [episodes] [eval-episodes]\n"
        + "                          Train tabular policies with held-out evaluation\n"
        + "  autorl show <id>        Inspect an AutoRL result\n"
        + "  autorl replay <id>      Verify a recorded RL config\n"
        + "  autotransformers run [budget] [seed]\n"
        + "                          Search transformer configs on CPU\n"
        + "  autotransformers show <policy>\n"
        + "                          Inspect a configuration result\n"
        + "  autotransformers replay <policy>\n"
        + "                          Verify a recorded config checksum\n"
        + "  autollm discover [dir]  Discover local model artifacts with checksums\n"
        + "  autollm evaluate <suite> <responses>\n"
        + "                          Score recorded responses offline\n"
        + "  autollm status          Report MAX inference boundary status honestly\n"
        + "  sciml list-problems     List scientific problem registry entries\n"
        + "  sciml solve [seed]      Identify a PDE parameter from observations\n"
        + "  sciml show <id>         Inspect a SciML result\n"
        + "  scidl run [seed]        Train and evaluate a scientific field model\n"
        + "  scidl show <id>         Inspect a SciDL result\n"
        + "  scirl run [episodes] [eval-episodes]\n"
        + "                          Select PDE solver resolution in a simulator\n"
        + "  scirl show <id>         Inspect a SciRL result\n"
        + "  looper run <hypothesis> [budget]\n"
        + "                          Run a validated scientific experiment loop\n"
        + "  looper show <id>        Inspect a loop run's transition history\n"
        + "  systems search [budget] [seed]\n"
        + "                          Search measured GPU launch configurations\n"
        + "  systems show            List recorded systems trials\n"
        + "  meta run [budget] [seed]\n"
        + "                          Compare experiment allocation policies\n"
        + "  meta graph              List causal evidence edges\n"
        + "  joint run [budget] [seed...]\n"
        + "                          Compare joint AI×compute search with ablations\n"
        + "  joint show              List recorded joint outcomes\n"
        + "  rsi run [trials] [--apply]\n"
        + "                          Bounded config-only self-improvement loop\n"
        + "  rsi show                Inspect protected records and decisions\n"
        + "  rsi rollback [--apply]  Restore the protected baseline config\n"
        + "  init <path>             Initialize a versioned local workspace\n"
        + "  experiment create <name> [seed]\n"
        + "                          Create a versioned experiment record\n"
        + "  experiment list [--json]\n"
        + "                          List local experiment records\n"
        + "  experiment show <id> [--json]\n"
        + "                          Inspect one experiment and its events\n"
        + "  experiment replay <id>  Verify inputs before replay\n"
        + "  automl inspect <csv> <target>\n"
        + "                          Validate a CSV dataset and show its schema\n"
        + "  automl run <csv> <target> [budget] [seed]\n"
        + "                          Run bounded regression AutoML on CPU\n"
        + "  automl show <id>        List trials for an experiment\n"
        + "  automl replay <id>      Recompute and verify a recorded result\n"
        + "  automl compare <a> <b>  Compare held-out RMSE of two experiments\n"
        + "  report <id>             Render a terminal report\n"
        + "  optimize run <csv> <target> [budget] [seed]\n"
        + "                          Adaptive search vs matched random baseline\n"
        + "  sinn list-problems      List supported scientific PDE problems\n"
        + "  sinn solve <problem> [seed] [iterations]\n"
        + "                          Solve a PDE with a physics-informed Mojo network\n"
        + "  sinn show <id>          Inspect a persisted SINN result\n"
        + "  sci-transformers train [seed] [epochs]\n"
        + "                          Train the scientific sequence transformer\n"
        + "  sci-transformers show <id>\n"
        + "                          Inspect a persisted transformer result\n"
        + "  sci-transformers predict <id> [sample]\n"
        + "                          Predict a held-out frame from a checkpoint\n"
        + "\n"
        + "PLANNED COMMANDS (not registered; no behavior yet)\n"
        + "  experiment compare, benchmark run, verify,\n"
        + "  classification, multi-fidelity search\n"
        + "\n"
        + "EXIT CODES\n"
        + "  0 success    1 failure    2 usage error    3 unavailable\n"
        + "  70 internal error    130 interrupted\n"
        + "\n"
        + "EXAMPLES\n"
        + "  hyperforge doctor\n"
        + "  hyperforge init ./workspace\n"
    )


def print_version() raises:
    print("hyperforge " + VERSION + " (" + MILESTONE + ")")
